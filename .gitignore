# Rust build artifacts
/target/
**/target/

# Ephemeris kernels — large binaries, fetched not committed
/kernels/*.bsp
/kernels/*.bpc
/kernels/*.tpc
/kernels/*.tls
/kernels/*.tf
# Compact chart ephemeris — generated by `cargo run --example build_compact`,
# which rebuilds it from the SPICE kernels in about two seconds.
/kernels/*.phce

# Data — catalogues and models are downloaded, not versioned
/data/

# macOS
.DS_Store

# Python build artifacts
/target/wheels/
*.egg-info/
__pycache__/

# wasm-pack output
/crates/ph-wasm/pkg/
